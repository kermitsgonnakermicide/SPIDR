<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="diddler_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libgz-sim-physics-system.so" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="libgz-sim-scene-broadcaster-system.so" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="libgz-sim-contact-system.so" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>.4 .4 .4</ambient>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.30 0.25 1</ambient>
            <diffuse>0.45 0.40 0.35 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ ROUGH TERRAIN: Bumps & Ramps ============ -->

    <!-- Small bump field (scattered pebbles) -->
    <model name="bump1">
      <pose>0.3 0.1 0.01 0 0 0.3</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.02</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.5 0.45 0.4 1</ambient><diffuse>0.6 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bump2">
      <pose>0.15 -0.15 0.015 0 0 1.1</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.025</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.5 0.45 0.4 1</ambient><diffuse>0.6 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bump3">
      <pose>-0.2 0.2 0.012 0 0 2.5</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.018</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.018</radius></sphere></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.65 0.6 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bump4">
      <pose>-0.1 -0.3 0.02 0 0 0.7</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.03</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bump5">
      <pose>0.4 -0.25 0.015 0 0 1.8</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.022</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.022</radius></sphere></geometry>
          <material><ambient>0.5 0.45 0.4 1</ambient><diffuse>0.6 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Medium rocks -->
    <model name="rock1">
      <pose>0.5 0.0 0.025 0.15 0.1 0.4</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.08 0.06 0.05</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.08 0.06 0.05</size></box></geometry>
          <material><ambient>0.4 0.38 0.35 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock2">
      <pose>-0.4 0.35 0.02 0.1 -0.05 1.9</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.07 0.05 0.04</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.07 0.05 0.04</size></box></geometry>
          <material><ambient>0.42 0.4 0.37 1</ambient><diffuse>0.52 0.5 0.47 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock3">
      <pose>0.25 0.45 0.03 -0.1 0.15 2.7</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 0.07 0.06</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 0.07 0.06</size></box></geometry>
          <material><ambient>0.38 0.36 0.33 1</ambient><diffuse>0.48 0.46 0.43 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Ramp / slope -->
    <model name="ramp1">
      <pose>0.6 -0.4 0.02 0 0.15 0.5</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.15 0.04</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.15 0.04</size></box></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.5 0.45 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Step / ledge -->
    <model name="step1">
      <pose>-0.5 -0.1 0.015 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 0.4 0.03</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 0.4 0.03</size></box></geometry>
          <material><ambient>0.35 0.32 0.28 1</ambient><diffuse>0.45 0.42 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="step2">
      <pose>-0.65 -0.1 0.035 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 0.4 0.07</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 0.4 0.07</size></box></geometry>
          <material><ambient>0.35 0.32 0.28 1</ambient><diffuse>0.45 0.42 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Scattered small cylinders (logs/debris) -->
    <model name="log1">
      <pose>0.1 0.5 0.01 1.5708 0 0.8</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.015</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.015</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="log2">
      <pose>-0.3 -0.5 0.012 1.5708 0 2.1</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Larger boulder -->
    <model name="boulder1">
      <pose>0.7 0.5 0.04 0.1 0.05 0.9</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.06</radius></sphere></geometry></collision>
        <visual name="vis"><geometry><sphere><radius>0.06</radius></sphere></geometry>
          <material><ambient>0.35 0.33 0.3 1</ambient><diffuse>0.45 0.43 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
