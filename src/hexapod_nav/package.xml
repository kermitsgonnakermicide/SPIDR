<?xml version="1.0"?>
<package format="3">
  <name>hexapod_nav</name>
  <version>0.1.0</version>
  <description>OctoMap-first hexapod 3D navigation with dynamic foothold placement</description>
  <maintainer email="daksh.vohra1@gmail.com">Daksh Vohra</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>grid_map_msgs</depend>
  <depend>octomap_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>rerun-sdk</exec_depend>
  <exec_depend>spooder_perception</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>