Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /OctoMap2
        - /Grid Map (floor)3
        - /Grid Map (ceiling)4
        - /Grid Map (clearance)5
        - /Grid Map (cost)6
        - /RobotModel1
        - /TF1
        - /PointCloud2 (Camera)7
        - /PointCloud2 (OctoMap)8
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Property Tree Widget:
      Expanded:
        - /Orbit1
    Splitter Ratio: 0.3
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2 (Camera)
      Color: 255; 255; 255
      Color Transformer: ""
      Enabled: true
      Position Transformer: ""
      Queue Size: 10
      Style: Points
      Topic:
        Depth Size: 1
        Value: /camera/depth/color/points
      Use rainbow: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2 (OctoMap)
      Color: 255; 0; 0
      Color Transformer: ""
      Enabled: true
      Position Transformer: ""
      Queue Size: 10
      Style: Points
      Topic:
        Depth Size: 1
        Value: /octomap_point_cloud_centers
      Use rainbow: false
    - Class: octomap_rviz_plugins/OctoMap
      Name: OctoMap2
      Color Mode: Z-Axis
      Enabled: true
      Max Color: 255; 255; 0
      Min Color: 0; 0; 255
      Topic:
        Depth Size: 1
        Value: /octomap_full
    - Class: grid_map_rviz_plugin/GridMap
      Name: Grid Map (floor)
      Enabled: true
      Layer: floor
      Topic:
        Depth Size: 1
        Value: /terrain_grid_map
      Color Scheme: viridis
      Min Color: 0; 0; 255
      Max Color: 255; 0; 0
    - Class: grid_map_rviz_plugin/GridMap
      Name: Grid Map (ceiling)
      Enabled: true
      Layer: ceiling
      Topic:
        Depth Size: 1
        Value: /terrain_grid_map
      Color Scheme: viridis
      Min Color: 0; 0; 255
      Max Color: 255; 0; 0
    - Class: grid_map_rviz_plugin/GridMap
      Name: Grid Map (clearance)
      Enabled: true
      Layer: clearance
      Topic:
        Depth Size: 1
        Value: /terrain_grid_map
      Color Scheme: viridis
      Min Color: 0; 255; 0
      Max Color: 255; 0; 0
    - Class: grid_map_rviz_plugin/GridMap
      Name: Grid Map (cost)
      Enabled: true
      Layer: cost
      Topic:
        Depth Size: 1
        Value: /terrain_costmap
      Color Scheme: viridis
      Min Color: 0; 255; 0
      Max Color: 255; 0; 0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel1
      Enabled: true
      Description Topic:
        Depth Size: 1
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF1
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            base_link:
              leg0_coxa:
                leg0_femur:
                  leg0_tibia:
                    leg0_tip: {}
              leg1_coxa:
                leg1_femur:
                  leg1_tibia:
                    leg1_tip: {}
              leg2_coxa:
                leg2_femur:
                  leg2_tibia:
                    leg2_tip: {}
              leg3_coxa:
                leg3_femur:
                  leg3_tibia:
                    leg3_tip: {}
              leg4_coxa:
                leg4_femur:
                  leg4_tibia:
                    leg4_tip: {}
              leg5_coxa:
                leg5_femur:
                  leg5_tibia:
                    leg5_tip: {}
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
    Toolbar Buttons: true
  Name: Root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/InitialPose
    - Class: rviz_default_plugins/SetGoal
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Enabled: true
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.1
      Name: Orbit
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins/Orbit)
      Yaw: 0.7
Window Geometry:
  Height: 1080
  Width: 1920
  X: 0
  Y: 0