<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spooder">
  <xacro:arg name="config_file" default=""/>

  <!-- Use the diddler mechanical model as the robot body/legs. -->
  <xacro:include filename="/home/daksh/spooder_ws/diddler/sim.xacro"/>

  <!-- Keep Spooder's simulation sensors and Nav2 frame names. -->
  <xacro:include filename="$(find spooder_description)/urdf/camera.xacro"/>
  <xacro:include filename="$(find spooder_description)/urdf/lidar.xacro"/>
  <xacro:include filename="$(find spooder_description)/urdf/imu.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Diddler joints, in the same order as spooder_control/config/ros2_control.yaml. -->
  <ros2_control name="SpooderSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <xacro:macro name="controlled_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <xacro:controlled_joint joint_name="R11"/>
    <xacro:controlled_joint joint_name="R12"/>
    <xacro:controlled_joint joint_name="R13"/>
    <xacro:controlled_joint joint_name="R21"/>
    <xacro:controlled_joint joint_name="R22"/>
    <xacro:controlled_joint joint_name="R23"/>
    <xacro:controlled_joint joint_name="R31"/>
    <xacro:controlled_joint joint_name="R32"/>
    <xacro:controlled_joint joint_name="R33"/>
    <xacro:controlled_joint joint_name="L11"/>
    <xacro:controlled_joint joint_name="L12"/>
    <xacro:controlled_joint joint_name="L13"/>
    <xacro:controlled_joint joint_name="L21"/>
    <xacro:controlled_joint joint_name="L22"/>
    <xacro:controlled_joint joint_name="L23"/>
    <xacro:controlled_joint joint_name="L31"/>
    <xacro:controlled_joint joint_name="L32"/>
    <xacro:controlled_joint joint_name="L33"/>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg config_file)</parameters>
    </plugin>

    <plugin filename="libgz-sim-odometry-publisher-system.so" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>spooder/odom</frame_id>
      <child_frame_id>spooder/base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.001</gaussian_noise>
    </plugin>
  </gazebo>

  <xacro:macro name="tibia_contact" params="link_name">
    <gazebo reference="${link_name}">
      <mu1>1.8</mu1>
      <mu2>1.8</mu2>
      <kp>100000.0</kp>
      <kd>10.0</kd>
      <self_collide>false</self_collide>
    </gazebo>
  </xacro:macro>

  <xacro:tibia_contact link_name="tibia_L1_1"/>
  <xacro:tibia_contact link_name="tibia_L2_1"/>
  <xacro:tibia_contact link_name="tibia_L3_1"/>
  <xacro:tibia_contact link_name="tibia_R1_1"/>
  <xacro:tibia_contact link_name="tibia_R2_1"/>
  <xacro:tibia_contact link_name="tibia_R3_1"/>

  <xacro:depth_camera parent_link="base_link" origin_xyz="0.095 0 0.15" origin_rpy="0 0 0"/>
  <xacro:lidar_sensor parent="base_link"/>
  <xacro:imu_sensor parent_link="base_link"/>
</robot>
