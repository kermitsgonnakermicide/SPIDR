<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spooder_robot</name>
  <version>0.1.0</version>
  <description>Onboard-spooder node: ST3215 + OAK-D Lite coordinator, IMU republisher, and tripod gait controller. Runs on the physical robot's onboard computer while planning/Nav2 runs on the laptop</description>
  <maintainer email="daksh.vohra1@gmail.com">Daksh Vohra</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>spooder_description</depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
 </export>
</package>
